---
/** ChairFeature — the lopsided feature row: photo cols 1–4, name and affiliation cols 6–12. */
import { href } from '../../lib/url';

interface Props {
  member: { name: string; affiliation: string; photo?: string };
}
const { member } = Astro.props;
---

<div class="grid chair">
  {
    member.photo && (
      <div class="chair__photo start-1 span-4">
        <img src={href(member.photo)} alt={`Portrait of ${member.name}`} width="800" height="1000" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class:list={['chair__text', member.photo ? 'start-6 span-7' : 'start-1 span-12']}>
    <p class="display h-54 chair__name">{member.name}</p>
    <p class="chair__aff">{member.affiliation}</p>
  </div>
</div>

<style>
  .chair {
    align-items: end;
    row-gap: var(--space-24);
  }
  .chair__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    background: var(--panel);
  }
  .chair__text {
    padding-top: var(--space-16);
    border-top: 3px solid var(--slate);
  }
  .chair__aff {
    margin-top: var(--space-12);
    font-family: var(--font-text);
    font-size: var(--fs-22);
    line-height: 1.3;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .chair__photo {
      max-width: 320px;
    }
    .chair__name {
      font-size: var(--fs-38);
    }
    .chair__aff {
      font-size: var(--fs-18);
    }
  }
</style>
