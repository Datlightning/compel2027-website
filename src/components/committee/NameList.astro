---
/** NameList — members without photos as a plain typographic list: 3 columns, 2 on tablet, 1 on phones. */
interface Props {
  members: { name: string; affiliation: string }[];
}
const { members } = Astro.props;
---

<ul class="plain-list names">
  {
    members.map((m) => (
      <li>
        <span class="names__name">{m.name}</span>
        <span class="names__aff">{m.affiliation}</span>
      </li>
    ))
  }
</ul>

<style>
  .names {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .names li {
    padding: var(--space-12) 0 var(--space-24);
    border-top: 1px solid var(--rule);
  }
  .names__name {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--fs-18);
    font-weight: 600;
    line-height: 1.3;
    color: var(--slate);
  }
  .names__aff {
    display: block;
    margin-top: var(--space-4);
    font-family: var(--font-text);
    font-size: var(--fs-16);
    line-height: 1.4;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .names {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .names {
      grid-template-columns: minmax(0, 1fr);
    }
    .names li {
      padding-bottom: var(--space-16);
    }
  }
</style>
