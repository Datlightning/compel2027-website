---
/**
 * Our Sponsors — driven by src/data/sponsors.json and not rendered at all while it is empty.
 * Entry shape: { "name": "Sponsor name", "logo": "/images/sponsor-x.png", "url": "https://…" (optional) }
 */
import sponsors from '../../data/sponsors.json';
import { href } from '../../lib/url';

type Sponsor = { name: string; logo: string; url?: string };
const list = sponsors as Sponsor[];
---

{
  list.length > 0 && (
    <section class="container section sponsors" aria-labelledby="sponsors-heading">
      <h2 id="sponsors-heading">Our Sponsors</h2>
      <ul class="plain-list sponsors__row">
        {list.map((s) => (
          <li>
            {s.url ? (
              <a href={s.url}>
                <img src={href(s.logo)} alt={s.name} loading="lazy" />
              </a>
            ) : (
              <img src={href(s.logo)} alt={s.name} loading="lazy" />
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .sponsors__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-32) var(--space-72);
    margin-top: var(--space-32);
    padding-top: var(--space-32);
    border-top: 1px solid var(--rule);
  }
  .sponsors__row a {
    display: block;
  }
  .sponsors__row img {
    display: block;
    height: 72px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
  }
  @media (max-width: 860px) {
    .sponsors__row {
      gap: var(--space-24) var(--space-48);
    }
    .sponsors__row img {
      height: 48px;
    }
  }
</style>
