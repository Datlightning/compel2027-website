---
/**
 * VenueRow — one venue: 7-column photo and 5-column text. `flip` puts the photo on the
 * right on desktop. DOM order is always photo then text, so phones stack photo first.
 */
import { href } from '../../lib/url';

interface Props {
  venue: {
    id: string;
    name: string;
    role: string;
    address: string;
    addressNote?: string;
    mapUrl: string;
    image: string;
    imageWidth: number;
    imageHeight: number;
    imageAlt: string;
    description: string;
  };
  flip?: boolean;
}

const { venue, flip = false } = Astro.props;
---

<section class:list={['grid', 'venue', flip && 'venue--flip']} aria-labelledby={`venue-${venue.id}`}>
  <div class:list={['venue__photo', 'span-7', flip ? 'start-6' : 'start-1']}>
    <img
      src={href(venue.image)}
      alt={venue.imageAlt}
      width={venue.imageWidth}
      height={venue.imageHeight}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class:list={['venue__text', 'span-5', flip ? 'start-1' : 'start-8']}>
    <h2 id={`venue-${venue.id}`}>{venue.name}</h2>
    <p class="venue__role">{venue.role}</p>
    <p class="venue__address">
      <a href={venue.mapUrl}>{venue.address}</a>{venue.addressNote && ` ${venue.addressNote}`}
    </p>
    <div class="prose venue__desc" set:html={venue.description} />
  </div>
</section>

<style>
  .venue {
    align-items: start;
    row-gap: var(--space-24);
  }
  .venue + .venue {
    margin-top: var(--space-72);
  }
  .venue__photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--panel);
  }
  .venue__role {
    margin-top: var(--space-12);
    font-family: var(--font-text);
    font-style: italic;
    font-size: var(--fs-22);
    line-height: 1.3;
    color: var(--text);
  }
  .venue__address {
    margin-top: var(--space-16);
    font-family: var(--font-ui);
    font-size: var(--fs-16);
    font-weight: 600;
    line-height: 1.3;
    color: var(--muted);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--rule);
  }
  .venue__address a {
    display: inline-block;
    padding-block: var(--space-12);
  }
  .venue__desc {
    margin-top: var(--space-24);
  }

  @media (min-width: 861px) {
    .venue__photo,
    .venue__text {
      grid-row: 1;
    }
  }
  @media (max-width: 860px) {
    .venue + .venue {
      margin-top: var(--space-48);
    }
  }
</style>
